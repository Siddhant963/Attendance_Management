# NODE_ENV=production on the hosting platform
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/attendflow
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins (no trailing slash), e.g. https://<your-frontend-host>
CLIENT_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
