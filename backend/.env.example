# NODE_ENV=production on the hosting platform
PORT=5000
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins (no trailing slash), e.g. https://<your-frontend-host>
CLIENT_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
# Only if mongodb+srv:// fails with querySrv ECONNREFUSED (router DNS refuses SRV lookups):
DNS_SERVERS=1.1.1.1,8.8.8.8
