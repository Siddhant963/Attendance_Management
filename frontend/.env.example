# Leave VITE_API_URL unset in development (Vite proxies /api to http://localhost:5000).
# In production set it to the deployed backend API, ending in /api, e.g. https://<your-backend-host>/api
# Both values are read at build time.
VITE_API_URL=

# Demo-login helpers are hidden unless this is exactly "true". Use true only for local evaluation
# or an isolated demo environment; keep it false for any real deployment.
VITE_SHOW_DEMO=false
